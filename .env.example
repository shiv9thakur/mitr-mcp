# Only for running the server by hand while developing. MCP clients (Claude Desktop, Gemini CLI) pass these via
# their own config instead; see README.md.

# Create one in the dashboard: https://app.mitranalytics.dev -> Settings -> API keys
MITR_API_KEY=mitr_live_...

# Optional. Defaults to https://api.mitranalytics.dev. Plain http is only accepted for localhost.
# MITR_API_BASE_URL=http://localhost:8000
